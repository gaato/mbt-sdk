/// Encodes this union as JSON.
pub extend CreateEmbeddingRequestInput with ToJson::{to_json}

///|
pub impl ToJson for CreateEmbeddingRequestInput with fn to_json(self) {
  match self {
    Text(value) => value.to_json()
    TextArray(value) => value.to_json()
    IntArray(value) => value.to_json()
    IntArrayArray(value) => value.to_json()
  }
}

///|
///
/// Decodes this union from JSON.
pub extend CreateEmbeddingRequestInput with @json.FromJson::{from_json}

///|
pub impl @json.FromJson for CreateEmbeddingRequestInput with fn from_json(
  value,
  path,
) {
  if value is String(_) {
    let decoded : String = @json.from_json(value, path~)
    return Text(decoded)
  }
  if json_array_matches(value, item => item is String(_)) {
    let decoded : Array[String] = @json.from_json(value, path~)
    return TextArray(decoded)
  }
  if json_array_matches(value, item => item is Number(_, ..)) {
    let decoded : Array[Int] = @json.from_json(value, path~)
    return IntArray(decoded)
  }
  if json_array_matches(value, item => {
      json_array_matches(item, item => item is Number(_, ..))
    }) {
    let decoded : Array[Array[Int]] = @json.from_json(value, path~)
    return IntArrayArray(decoded)
  }
  raise @json.JsonDecodeError(
    (path, "JSON shape does not match any CreateEmbeddingRequestInput variant"),
  )
}

