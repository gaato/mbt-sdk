// Replays recorded badhttp.dev responses (see scripts/capture_badhttp.mbtx)
// through a loopback server; runs offline, in the gates.
import {
  "gaato/mttp_core" @http,
  "gaato/mttp_core/cookie",
  "gaato/mttp_core/sim" @mock,
  "gaato/mttp_core/sse",
  "gaato/mttp/backend",
  "gaato/mttp/codings",
  "gaato/mttp/runtime",
  "gaato/mttp_core/client",
  "moonbitlang/core/async",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
} for "wbtest"

supported_targets = "native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/socket",
  ],
)
