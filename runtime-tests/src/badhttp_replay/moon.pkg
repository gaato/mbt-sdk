// Replays recorded badhttp.dev responses (see scripts/capture_badhttp.mbtx)
// through a loopback server; runs offline, in the gates.
import {
  "gaato/mttp" @http,
  "gaato/mttp/cookie",
  "gaato/mttp/sim" @mock,
  "gaato/mttp/sse",
  "gaato/mttp_async/backend",
  "gaato/mttp_async/codings",
  "gaato/mttp_async/runtime",
  "gaato/mttp/client",
  "moonbitlang/core/async",
  "moonbitlang/core/async/socket",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
} for "wbtest"

supported_targets = "native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/socket",
  ],
)
