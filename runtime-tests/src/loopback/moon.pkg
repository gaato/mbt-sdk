// Native only: the server side of these uploads is moonbitlang/core/async's HTTP
// server, which has no JS implementation.
import {
  "gaato/mttp_core" @http,
  "gaato/mttp/backend",
  "gaato/mttp_core/multipart",
  "moonbitlang/core/async",
  "moonbitlang/core/async/http" @ahttp,
  "moonbitlang/core/async/socket",
  "moonbitlang/core/encoding/utf8",
} for "test"

supported_targets = "native"

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/http",
    "moonbitlang/core/async/socket",
  ],
)
