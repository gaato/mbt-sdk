// Opt-in tests against the real LLM and GitHub APIs. They need credentials and
// the network and are never part of the gates: run them with scripts/live.sh.
import {
  "gaato/mttp/runtime" @adapter,
  "gaato/mttp/backend",
  "gaato/mttp/codings",
  "gaato/mttp_core" @http,
  "gaato/mttp_core/client" @runtime,
  "gaato/mttp_core/client/ratelimit",
  "gaato/openai" @openai_sdk,
  "gaato/anthropic" @anthropic_sdk,
  "gaato/anthropic/gen" @anthropic_gen,
  "gaato/github" @github_sdk,
  "gaato/github/gen" @github_gen,
  "moonbitlang/core/async",
  "moonbitlang/core/debug",
  "moonbitlang/core/env",
} for "test"

supported_targets = "native"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)
