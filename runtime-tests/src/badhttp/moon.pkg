// Opt-in conformance tests against https://badhttp.dev, a public, stateless
// catalogue of HTTP edge cases. They need the network and are not part of the
// gates: run them with scripts/conformance.sh. Keep the request count small;
// the service allows 100 requests per 10 s per IP.
import {
  "gaato/mttp" @http,
  "gaato/mttp_async/backend",
  "gaato/mttp_async/codings",
  "gaato/mttp_async/runtime" @adapter,
  "gaato/mttp/client" @runtime,
  "gaato/fixture-badhttp" @fixture,
  "moonbitlang/core/async",
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
} for "test"

supported_targets = "native"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)
