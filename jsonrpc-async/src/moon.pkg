supported_targets = "js + native"

import {
  "gaato/jsonrpc",
  "moonbitlang/async",
  "moonbitlang/async/io",
  "moonbitlang/async/aqueue",
  "moonbitlang/async/process",
  "moonbitlang/core/debug",
}

import {
  "moonbitlang/core/encoding/utf8",
  "gaato/jsonrpc-async" @jsonrpc_async,
} for "test"

import {
  "moonbitlang/core/encoding/utf8",
} for "wbtest"

// The process import is native-only. moon accepts #cfg imports, but the
// pinned moonc still rejects them in moon.pkg, so it is unused on JS.

warnings = "-unused_package"

options(
  targets: {
    "child.mbt": [ "native" ],
    "child_test.mbt": [ "native" ],
    "lifecycle_native_wbtest.mbt": [ "native" ],
  },
)
