supported_targets = "js + native"

import {
  "gaato/jsonrpc",
  "moonbitlang/async",
  "moonbitlang/async/io",
  "moonbitlang/async/aqueue",
  "moonbitlang/async/process",
  "moonbitlang/core/debug",
}

import {
  "moonbitlang/core/encoding/utf8",
  "gaato/jsonrpc-async" @jsonrpc_async,
} for "test"

// The process import is used only by native files. Moon does not yet support
// conditional imports; on JS it is intentionally unused. Keep other warnings on.

warnings = "-unused_package"

options(
  targets: { "child.mbt": [ "native" ], "child_test.mbt": [ "native" ] },
)
