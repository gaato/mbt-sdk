// GENERATED by tools/gen — DO NOT EDIT.

///|
/// How the following page is addressed; cursor names come from the API contract.
pub(all) enum PageKind {
  Cursor(String)
  NextUrl
}

///|
priv suberror PageDecodeError {
  PageDecodeError(String)
}

///|
fn page_field(value : Json, path : String) -> Json? raise PageDecodeError {
  let mut current = value
  for part in path.split(".") {
    match current {
      Object(fields) =>
        match fields.get(part.to_owned()) {
          Some(value) => current = value
          None => return None
        }
      _ => raise PageDecodeError("pagination field path traverses a non-object")
    }
  }
  Some(current)
}

///|
/// Paginates JSON arrays by cursor query parameter or next URL. Offset pagination
/// is not supported. A page advances only after successful decoding.
pub fn[T : @json.FromJson] Petstore3::paginate(
  self : Petstore3,
  first : @http.Request,
  kind~ : PageKind,
  items~ : String,
  next~ : String,
  operation~ : String = self.infer_operation(first),
) -> @client.Paginator[T, Failure] {
  let cursor : Ref[String?] = Ref(None)
  let done = Ref(false)
  @client.Paginator::new(() => {
    if done.val {
      return Ok(None)
    }
    for ;; {
      let request = match cursor.val {
        None => first
        Some(value) =>
          match kind {
            NextUrl => { ..first, url: value, }
            Cursor(param) => {
              let url = @http.Url::parse(first.url)
              {
                ..first,
                url: url.merge_query_params([(param, value)]).to_string(),
              }
            }
          }
      }
      match self.send(request, operation~) {
        Err(error) => return Err(error)
        Ok(reply) =>
          try {
            let json = @json.parse(@utf8.decode(reply.body))
            let values = match page_field(json, items) {
              Some(Array(values)) => values
              None => []
              _ => raise PageDecodeError("pagination items must be an array")
            }
            let next_cursor = match page_field(json, next) {
              Some(String(value)) if value != "" => Some(value)
              Some(Null) | None => None
              Some(String(_)) => None
              _ =>
                raise PageDecodeError(
                  "pagination next must be a string or null",
                )
            }
            let typed : Array[T] = values.map(value => @json.from_json(value))
            let next_cursor = match (kind, next_cursor) {
              (NextUrl, Some(reference)) => {
                let current = reply.attributes
                  .get(@client.final_url)
                  .unwrap_or(reply.request.url)
                Some(
                  @http.Url::parse(current)
                  .resolve(@http.Url::parse(reference))
                  .to_string(),
                )
              }
              _ => next_cursor
            }
            cursor.val = next_cursor
            done.val = next_cursor is None
            if !typed.is_empty() {
              return Ok(Some(typed))
            }
            if done.val {
              return Ok(None)
            }
          } catch {
            error =>
              return Err(
                Decode(
                  @client.Deserialization(
                    { status: reply.status, headers: reply.headers, },
                    message=error.to_string(),
                    body=reply.body[:reply.body
                    .length()
                    .min(@client.max_error_body)].to_owned(),
                  ),
                ),
              )
          }
      }
    }
  })
}
