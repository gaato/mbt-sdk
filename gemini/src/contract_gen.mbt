///|
test "generated stream propagates nested request validation from its callback" {
  let clock = @sim.FakeClock::new()
  let backend = @client.from_fn((_, _) => {
    @http.Response::new(200, body=@http.Body::Bytes(b"data: callback\n\n"))
  })
  let nested_backend = @client.from_fn((_, _) => {
    abort("invalid nested request reached the backend")
  })
  let nested = @client.Client::new(nested_backend, clock)
  let sdk = Gemini::new(backend, clock)
  @driver.run_sync(() => {
    let invalid = @http.Request::get("https://nested.example").header(
      "x-test", " invalid",
    )
    let outer = sdk.stream(@http.Request::get("/contract-test"), _ => {
      ignore(nested.send(@client.request(invalid).response(@client.as_bytes())))
    }) catch {
      @http.TransportError::TransportError(kind=Invalid, phase=Pool, ..) =>
        return
      error => raise error
    }
    fail(
      "expected the nested request error to raise, got " +
      @debug.to_string(outer),
    )
  })
}

///|
test "generated base override, paginator termination and SSE stop" {
  let count = Ref::Ref(0)
  let backend = @client.from_fn((request, _) => {
    try! assert_true(request.url.has_prefix("https://override.example/"))
    count.val += 1
    @http.Response::new(
      200,
      body=@http.Body::Bytes(
        if count.val == 1 {
          b"{\"results\":[1],\"next\":\"https://override.example/page2\"}"
        } else {
          b"{\"results\":[2],\"next\":null}"
        },
      ),
    )
  })
  let sdk = Gemini::new(
    backend,
    @sim.FakeClock::new(),
    base_url="https://override.example",
  )
  let pages : @client.Paginator[Json, Failure] = sdk.paginate(
    @http.Request::get("/page1"),
    kind=PageKind::NextUrl,
    items="results",
    next="next",
  )
  @driver.run_sync(() => {
    try! assert_true(pages.next_page() is Result::Ok(Option::Some(_)))
    try! assert_true(pages.next_page() is Result::Ok(Option::Some(_)))
    try! assert_true(pages.next_page() is Result::Ok(Option::None))
  })
  try! assert_eq(count.val, 2)
  let seen : Ref[Array[String]] = Ref::Ref([])
  let driver = @driver.Driver::new()
  let source = @sim.Feed::bytes(driver, [
    b"data: one\n\n", b"data: stop\n\n", b"data: unreachable\n\n",
  ])
  let backend = @client.from_fn((_, _) => {
    @http.Response::new(
      200,
      headers=@http.Headers::of([("content-type", "text/event-stream")]),
      body=@http.Body::Stream(@http.StreamBody::new(source)),
    )
  })
  let sdk = Gemini::new(backend, @sim.FakeClock::new())
  try! assert_true(
    driver.run(() => {
      sdk.stream(
        @http.Request::get("/stream"),
        event => seen.val.push(event.data),
        stop=event => event.data == "stop",
      )
    })
    is Result::Ok(_),
  )
  try! assert_eq(seen.val, ["one"])
  try! assert_eq(source.closes(), 1)
  try! assert_eq(source.reads(), 2)
}

///|
test "generated cursor pages replace the cursor and preserve failures" {
  let seen : Array[String] = []
  let backend = @client.from_fn((request, _) => {
    seen.push(request.url)
    let body = match seen.length() {
      1 => b"{\"data\":[],\"next\":\"first\"}"
      2 => b"bad json"
      3 => b"{\"data\":[1],\"next\":\"last\"}"
      _ => b"{\"data\":[2],\"next\":null}"
    }
    @http.Response::new(200, body=@http.Body::Bytes(body))
  })
  let sdk = Gemini::new(backend, @sim.FakeClock::new())
  let pages : @client.Paginator[Json, Failure] = sdk.paginate(
    @http.Request::get("/pages?cursor=old&limit=2"),
    kind=PageKind::Cursor("cursor"),
    items="data",
    next="next",
  )
  @driver.run_sync(() => {
    try! assert_true(pages.next_page() is Result::Err(Failure::Decode(_)))
    try! assert_true(
      pages.next_page() is Result::Ok(Option::Some([@json.Json::Number(1, ..)])),
    )
    try! assert_true(
      pages.next_page() is Result::Ok(Option::Some([@json.Json::Number(2, ..)])),
    )
    try! assert_true(pages.next_page() is Result::Ok(Option::None))
  })
  try! assert_eq(seen.length(), 4)
  try! assert_eq(seen[1], seen[2])
  try! assert_true(seen[3].contains("cursor=last"))
  try! assert_true(seen[3].contains("limit=2"))
  try! assert_false(seen[3].contains("cursor=old"))
}

