        "/"
      } else if parsed.path.has_prefix(prefix + "/") {
        parsed.path[prefix.length():].to_owned()
      } else {
        return false
      }
    } else {
      parsed.path
    }
  } catch {
    _ => return false
  }
  let actual = path.split("/").collect()
  let expected = template.split("/").collect()
  if actual.length() != expected.length() {
    return false
  }
  for i, part in expected {
    if !(part.has_prefix("{") && part.has_suffix("}")) && part != actual[i] {
      return false
    }
  }
  true
}

