test "generated default retry reaches the runtime" {
  let clock = @sim.FakeClock::new()
  let count = Ref::Ref(0)
  let backend = @client.from_fn((_, _) => {
    count.val += 1
    @http.Response::new(
      if count.val == 1 {
        503
      } else {
        200
      },
      body=@http.Body::Bytes(b"ok"),
    )
  })
  let sdk = CloudflareDns::new(
    backend,
    clock,
    auth=Auth::ApiToken("fixture-token"),
  )
  ignore(@driver.run_sync(() => sdk.send(@http.Request::get("/contract-test"))))
  try! assert_eq(default_retry(), {
    rule: {
      max_retries: 2,
      statuses: [
        {
          statuses: [
            @client.StatusMatch::Range(408, 409),
            @client.StatusMatch::Range(500, 599),
          ],
          methods: @client.Methods::Listed([
            @http.Method::parse("DELETE"),
            @http.Method::parse("GET"),
            @http.Method::parse("HEAD"),
            @http.Method::parse("PUT"),
          ]),
        },
        {
          statuses: [@client.StatusMatch::Code(429)],
          methods: @client.Methods::Listed([
            @http.Method::parse("DELETE"),
            @http.Method::parse("GET"),
            @http.Method::parse("HEAD"),
            @http.Method::parse("PATCH"),
            @http.Method::parse("POST"),
            @http.Method::parse("PUT"),
          ]),
        },
      ],
      sent_failures: @client.Methods::Listed([
        @http.Method::parse("GET"),
        @http.Method::parse("HEAD"),
        @http.Method::parse("PUT"),
        @http.Method::parse("DELETE"),
      ]),
      unsent_failures: true,
      override_header: Option::Some("x-should-retry"),
      retry_after: {
        source: @client.RetryAfterSource::MsThenHeader,
        cap: @client.RetryAfterCap::NoCap,
        zero_means_backoff: false,
      },
      backoff: {
        base_ms: 500,
        max_ms: 8000,
        jitter: @client.Jitter::Proportional(lo=750, hi=1000),
      },
    },
  })
  ignore(count)
  ignore(clock)
}

///|
test "generated from_client auth ApiToken and redirect boundaries" {
  for same_origin in [true, false] {
    let count = Ref::Ref(0)
    let backend = @client.from_fn((request, _) => {
      count.val += 1
      if count.val == 1 {
        try! assert_eq(
          request.headers.get("authorization"),
          Option::Some("Bearer test-secret"),
        )
        try! assert_true(
          request.attributes
          .get(@http.credential_headers)
          .unwrap_or([])
          .contains("authorization"),
        )
        let curl = @client.request(request)
          .response(@client.as_bytes())
          .to_curl()
        try! assert_false(curl.contains("Bearer test-secret"))

        @http.Response::new(
          302,
          headers=@http.Headers::of([
            (
              "location",
              if same_origin {
                "/next"
              } else {
                "https://other.example/next"
              },
            ),
          ]),
        )
      } else {
        try! assert_eq(
          request.headers.get("authorization"),
          if same_origin {
            Option::Some("Bearer test-secret")
          } else {
            Option::None
          },
        )
        @http.Response::new(200, body=@http.Body::Bytes(b"ok"))
      }
    })
    let config = {
      ..@client.RedirectConfig::default(),
      credential_headers: [],
    }
    let runtime = @client.Client::new(
      backend,
      @sim.FakeClock::new(),
      redirect=config,
    )
    let sdk = CloudflareDns::from_client(
      runtime,
      auth=Auth::ApiToken("test-secret"),
    )
    try! assert_true(
      @driver.run_sync(() => sdk.send(@http.Request::get("/contract-test")))
      is Result::Ok(_),
    )
    try! assert_eq(count.val, 2)
  }
  let backend = @client.from_fn((_, _) => {
    abort("invalid credentials reached the backend")
  })
  for value in [" leading", "trailing\t"] {
    let sdk = CloudflareDns::new(
      backend,
      @sim.FakeClock::new(),
      auth=Auth::ApiToken(value),
    )
    try! assert_true(
      @driver.run_sync(() => sdk.send(@http.Request::get("/contract-test")))
      is Result::Err(Failure::Validation(parameter="headers", ..)),
    )
  }
}

///|
test "generated bundled authorization, redaction and cross-origin redirect" {
  let count = Ref::Ref(0)
  let backend = @client.from_fn((request, _) => {
    count.val += 1
    try! assert_eq(
      request.headers.get("x-auth-email"),
      if count.val == 1 {
        Option::Some("fixture-email")
      } else {
        Option::None
      },
    )
    try! assert_true(
      request.attributes
      .get(@http.credential_headers)
      .unwrap_or([])
      .contains("x-auth-email"),
    )
    try! assert_false(
      @client.request(request).to_curl().contains("fixture-email"),
    )
    try! assert_eq(
      request.headers.get("x-auth-key"),
      if count.val == 1 {
        Option::Some("fixture-key")
      } else {
        Option::None
      },
    )
    try! assert_true(
      request.attributes
      .get(@http.credential_headers)
      .unwrap_or([])
      .contains("x-auth-key"),
    )
    try! assert_false(
      @client.request(request).to_curl().contains("fixture-key"),
    )
    try! assert_eq(request.headers.get("authorization"), Option::None)
    if count.val == 1 {
      @http.Response::new(
        302,
        headers=@http.Headers::of([("location", "https://other.example/next")]),
      )
    } else {
      @http.Response::new(200)
    }
  })
  let auth = Auth::GlobalApiKey(email="fixture-email", key="fixture-key")
  try! assert_false(@debug.to_string(auth).contains("fixture-"))
  let config = { ..@client.RedirectConfig::default(), credential_headers: [], }
  let runtime = @client.Client::new(
    backend,
    @sim.FakeClock::new(),
    redirect=config,
  )
  let sdk = CloudflareDns::from_client(runtime, auth~)
  let request = @http.Request::get("/contract-test").header(
    "authorization", "preexisting",
  )
  try! assert_true(@driver.run_sync(() => sdk.send(request)) is Result::Ok(_))
  try! assert_eq(count.val, 2)
  let invalid_backend = @client.from_fn((_, _) => {
    abort("invalid credentials reached the backend")
  })
  let sdk = CloudflareDns::new(
    invalid_backend,
    @sim.FakeClock::new(),
    auth=Auth::GlobalApiKey(email=" leading", key="ok"),
  )
  try! assert_true(
    @driver.run_sync(() => sdk.send(@http.Request::get("/contract-test")))
    is Result::Err(Failure::Validation(parameter="headers", ..)),
  )
  let sdk = CloudflareDns::new(
    invalid_backend,
    @sim.FakeClock::new(),
    auth=Auth::GlobalApiKey(email="ok", key=" leading"),
  )
  try! assert_true(
    @driver.run_sync(() => sdk.send(@http.Request::get("/contract-test")))
    is Result::Err(Failure::Validation(parameter="headers", ..)),
  )
}

