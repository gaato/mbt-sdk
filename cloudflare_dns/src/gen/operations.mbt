///|
///
/// Import DNS Records
pub fn dns_records_for_a_zone_import_dns_records_request(
  zone_id : String,
  zone_file : String,
  proxied? : Bool,
) -> @http.Request raise @multipart.MultipartError {
  let request = @http.Request::post(
    "/zones/" +
    @http.percent_encode(parameter_value(zone_id)) +
    "/dns_records/import",
  )
  let parts : Array[@multipart.Part] = []
  parts.push(@multipart.Part::text("file", parameter_value(zone_file)))
  if proxied is Option::Some(value) {
    parts.push(@multipart.Part::text("proxied", parameter_value(value)))
  }
  multipart_with_boundary_(request, parts)
}

