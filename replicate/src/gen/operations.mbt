/// Decodes a successful predictions.cancel response.
pub fn predictions_cancel_decode(
  head : @http.ResponseHead,
  body : Bytes,
) -> Result[SchemasPredictionResponse, @client.ResponseFailure] {
  decode_response(head, body)
}

///|
///
/// Search models, collections, and docs (beta)
pub fn search_request(query : String, limit? : Int32) -> @http.Request {
  let mut url = "/search"
  url = @http.append_query(url, "query", parameter_value(query))
  match limit {
    Some(value) =>
      url = @http.append_query(url, "limit", parameter_value(value))
    None => ()
  }
  @http.Request::get(url)
}

///|
///
/// Decodes a parsed successful search response.
pub fn search_decode_json(
  value : Json,
) -> SchemasSearchResponse raise @json.JsonDecodeError {
  @json.from_json(value)
}

///|
///
/// Decodes a successful search response.
pub fn search_decode(
  head : @http.ResponseHead,
  body : Bytes,
) -> Result[SchemasSearchResponse, @client.ResponseFailure] {
  decode_response(head, body)
}

