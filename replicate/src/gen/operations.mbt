///|
///
/// Get a training
pub fn trainings_get_request(training_id : String) -> @http.Request {
  @http.Request::get(
    "/trainings/" + @http.percent_encode(parameter_value(training_id)),
  )
}

///|
///
/// Decodes a parsed successful trainings.get response.
pub fn trainings_get_decode_json(
  value : Json,
) -> SchemasTrainingResponse raise @json.JsonDecodeError {
  @json.from_json(value)
}

///|
///
/// Decodes a successful trainings.get response.
pub fn trainings_get_decode(
  head : @http.ResponseHead,
  body : Bytes,
) -> Result[SchemasTrainingResponse, @client.ResponseFailure] {
  decode_response(head, body)
}

///|
///
/// Cancel a training
pub fn trainings_cancel_request(training_id : String) -> @http.Request {
  @http.Request::post(
    "/trainings/" +
    @http.percent_encode(parameter_value(training_id)) +
    "/cancel",
  )
}

///|
///
/// Decodes a parsed successful trainings.cancel response.
pub fn trainings_cancel_decode_json(
  value : Json,
) -> SchemasTrainingResponse raise @json.JsonDecodeError {
  @json.from_json(value)
}

