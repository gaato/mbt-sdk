// GENERATED by tools/gen — DO NOT EDIT.

///|
test "generated default URL, bucket, HTTP and transport failures" {
  let backend = @client.from_fn((request, _) => {
    try! assert_eq(
      request.url,
      @http.join_url("https://api.replicate.com/v1", "/contract-test"),
    )
    try! assert_eq(
      request.attributes.get(@client.rate_limit_bucket),
      Option::Some("replicate" + ":"),
    )
    @http.Response::new(
      400,
      headers=@http.Headers::of([("x-test", "retained")]),
      body=@http.Body::Bytes(b"{\"error\":\"bad\"}"),
    )
  })
  let sdk = Replicate::new(backend, @sim.FakeClock::new())
  match @driver.run_sync(() => sdk.send(@http.Request::get("/contract-test"))) {
    Result::Err(Failure::Http(error)) => {
      try! assert_eq(error.head.status, 400)
      try! assert_eq(error.head.headers.get("x-test"), Option::Some("retained"))
      try! assert_eq(error.body, b"{\"error\":\"bad\"}")
    }
    _ => fail("expected HTTP failure")
  }
  let failing = @client.from_fn((_, _) => {
    raise @http.TransportError::TransportError(
      kind=Network,
      phase=Body,
      detail="offline test",
    )
  })
  let sdk = Replicate::new(
    failing,
    @sim.FakeClock::new(),
    retry=@client.RetryPolicy::none(),
  )
  match
    @driver.run_sync(() => sdk.send(@http.Request::post("/contract-test"))) {
    Result::Err(
      Failure::Transport(
        @http.TransportError::TransportError(kind~, phase~, ..),
      ),
    ) => {
      try! assert_true(kind is Network)
      try! assert_true(phase is Body)
    }
    _ => fail("expected transport failure")
  }
}

///|
test "generated header whitespace is a validation failure before I/O" {
  let count = Ref::Ref(0)
  let backend = @client.from_fn((_, _) => {
    count.val += 1
    @http.Response::new(200)
  })
  let sdk = Replicate::new(backend, @sim.FakeClock::new())
  for value in [" leading", "trailing\t"] {
    let request = @http.Request::post("/contract-test").header(
      "idempotency-key", value,
    )
    try! assert_true(
      @driver.run_sync(() => sdk.send(request))
      is Result::Err(Failure::Validation(parameter="headers", ..)),
    )
    try! assert_true(
      @driver.run_sync(() => sdk.stream(request, _ => ()))
      is Result::Err(Failure::Validation(parameter="headers", ..)),
    )
  }
  try! assert_eq(count.val, 0)
}

