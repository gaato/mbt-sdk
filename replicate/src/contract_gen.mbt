///|
test "generated typed HTTP error body" {
  let body = @utf8.encode("{}")
  let backend = @client.from_fn((_, _) => {
    @http.Response::new(400, body=@http.Body::Bytes(body))
  })
  let sdk = Replicate::new(
    backend,
    @sim.FakeClock::new(),
    retry=@client.RetryPolicy::none(),
  )
  match
    @driver.run_sync(() => {
      sdk.send(@http.Request::get("/contract-test"), operation="search")
    }) {
    Result::Err(Failure::Http(failure)) => {
      try! assert_true(failure.typed is Option::Some(_))
      try! assert_eq(failure.body, body)
    }
    _ => fail("expected typed HTTP error")
  }
}

///|
test "generated provider timeout default and caller override" {
  let seen : Array[Int32?] = []
  let backend = @client.from_fn((_, options) => {
    seen.push(options.timeout_ms)
    @http.Response::new(200)
  })
  let sdk = Replicate::new(backend, @sim.FakeClock::new())
  ignore(@driver.run_sync(() => sdk.send(@http.Request::get("/contract-test"))))
  let sdk = Replicate::new(backend, @sim.FakeClock::new(), timeout_ms=1234)
  ignore(@driver.run_sync(() => sdk.send(@http.Request::get("/contract-test"))))
  try! assert_eq(seen, [Option::Some(70000), Option::Some(1234)])
}
