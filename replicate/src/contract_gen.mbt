  let sdk = Replicate::new(backend, clock)
  ignore(@driver.run_sync(() => sdk.send(@http.Request::get("/contract-test"))))
  try! assert_eq(default_retry(), {
    rule: {
      max_retries: 5,
      statuses: [
        {
          statuses: [@client.StatusMatch::Code(429)],
          methods: @client.Methods::Listed([
            @http.Method::parse("DELETE"),
