            @http.Method::parse("DELETE"),
            @http.Method::parse("GET"),
            @http.Method::parse("HEAD"),
            @http.Method::parse("OPTIONS"),
            @http.Method::parse("PUT"),
          ]),
        },
      ],
      sent_failures: @client.Methods::Never,
      unsent_failures: false,
      override_header: Option::None,
      retry_after: {
        source: @client.RetryAfterSource::Header,
        cap: @client.RetryAfterCap::BackoffAbove(60000),
        zero_means_backoff: false,
      },
      backoff: {
        base_ms: 500,
        max_ms: 60000,
        jitter: @client.Jitter::Proportional(lo=900, hi=1100),
      },
    },
  })
  ignore(count)
  ignore(clock)
}

///|
test "generated from_client auth Bearer and redirect boundaries" {
  for same_origin in [true, false] {
    let count = Ref::Ref(0)
    let backend = @client.from_fn((request, _) => {
      count.val += 1
      if count.val == 1 {
        try! assert_eq(
          request.headers.get("authorization"),
          Option::Some("Bearer test-secret"),
        )
        try! assert_true(
          request.attributes
          .get(@http.credential_headers)
          .unwrap_or([])
          .contains("authorization"),
        )
        let curl = @client.request(request)
          .response(@client.as_bytes())
          .to_curl()
        try! assert_false(curl.contains("Bearer test-secret"))

        @http.Response::new(
          302,
          headers=@http.Headers::of([
            (
              "location",
              if same_origin {
                "/next"
              } else {
                "https://other.example/next"
              },
            ),
          ]),
        )
      } else {
        try! assert_eq(
          request.headers.get("authorization"),
          if same_origin {
            Option::Some("Bearer test-secret")
          } else {
            Option::None
          },
        )
        @http.Response::new(200, body=@http.Body::Bytes(b"ok"))
      }
    })
    let config = {
      ..@client.RedirectConfig::default(),
      credential_headers: [],
    }
    let runtime = @client.Client::new(
      backend,
      @sim.FakeClock::new(),
      redirect=config,
    )
    let sdk = Replicate::from_client(runtime, auth=Auth::Bearer("test-secret"))
    try! assert_true(
      @driver.run_sync(() => sdk.send(@http.Request::get("/contract-test")))
      is Result::Ok(_),
    )
    try! assert_eq(count.val, 2)
  }
  let backend = @client.from_fn((_, _) => {
    abort("invalid credentials reached the backend")
  })
  for value in [" leading", "trailing\t"] {
    let sdk = Replicate::new(
      backend,
      @sim.FakeClock::new(),
      auth=Auth::Bearer(value),
    )
    try! assert_true(
      @driver.run_sync(() => sdk.send(@http.Request::get("/contract-test")))
      is Result::Err(Failure::Validation(parameter="headers", ..)),
    )
  }
}

