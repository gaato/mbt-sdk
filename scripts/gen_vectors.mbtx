// Writes the third-party test data of the conformance module as MoonBit
// test files, each holding the upstream data as JSON in a string, one entry
// per line, so the tests read the data as it was published. The sources are
// pinned in conformance/NOTICE; download them, then run, from the
// repository root:
//
//   moon run scripts/gen_vectors.mbtx -- url <urltestdata.json>
//   moon run scripts/gen_vectors.mbtx -- cookie <parser.ts> <examples.ts> <bsd-examples.ts>
//
// `url` keeps the rows of web-platform-tests' urltestdata.json whose input
// or result is an http, https, ws or wss URL; the tests decide which of
// those apply. `cookie` turns tough-cookie's copies of the http-state tests,
// TypeScript object literals, into JSON.
//
// This is not part of the gates: it runs only when the pinned sources move.

import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.6/sys",
}

///|
let header : String = "// GENERATED by scripts/gen_vectors.mbtx from the sources in conformance/NOTICE — DO NOT EDIT.\n"

///|
/// A MoonBit declaration of `name` holding `rows`, one JSON value per line.
fn string_of_rows(name : String, rows : Array[Json]) -> String {
  let out = StringBuilder()
  out.write_string("\n///|\nlet \{name} : String =\n")
  for i, row in rows {
    let separator = if i + 1 < rows.length() { "," } else { "" }
    let opening = if i == 0 { "[" } else { "" }
    out.write_string("  #|\{opening}\{row.stringify()}\{separator}\n")
  }
  if rows.is_empty() {
    out.write_string("  #|[\n")
  }
  out.write_string("  #|]\n")
  out.to_string()
}

///|
fn special_url(text : String) -> Bool {
  let lower = text.trim(chars=" \t\n\r").to_lower()
  ["http:", "https:", "ws:", "wss:"].iter().any(scheme => lower.has_prefix(scheme))
}

///|
fn url_rows(source : String) -> Array[Json] raise {
  guard @json.parse(source) is Array(rows) else { fail("expected an array") }
  rows.filter(row => {
    guard row is Object(fields) else { return false }
    match (fields.get("href"), fields.get("input"), fields.get("base")) {
      (Some(String(href)), _, _) => special_url(href)
      (None, Some(String(input)), Some(Null) | None) => special_url(input)
      (None, Some(String(input)), Some(String(base))) =>
        special_url(input) || special_url(base)
      _ => false
    }
  })
}

///|
/// A TypeScript `export default` literal as JSON: unquoted keys quoted,
/// single-quoted strings double-quoted, trailing commas dropped. Escapes in
/// the sources (`\t`, `\uXXXX`, `\\`) mean the same in JSON; `\'` is a quote.
fn literal_to_json(source : String) -> Json raise {
  let text = source.trim(chars=" \t\n\r;")
  let text = match text.strip_prefix("export default") {
    Some(rest) => rest.to_owned()
    None => fail("expected `export default`")
  }
  let text = text.trim(chars=" \t\n\r")
  let text = text.strip_suffix("as const").unwrap_or(text).to_owned()
  let chars = text.to_array()
  let out = StringBuilder()
  let mut i = 0
  while i < chars.length() {
    let c = chars[i]
    if c == '\'' {
      out.write_char('"')
      i += 1
      while chars[i] != '\'' {
        if chars[i] == '\\' && chars[i + 1] == '\'' {
          out.write_char('\'')
          i += 2
        } else if chars[i] == '\\' {
          out.write_char('\\')
          out.write_char(chars[i + 1])
          i += 2
        } else {
          if chars[i] == '"' {
            out.write_char('\\')
          }
          out.write_char(chars[i])
          i += 1
        }
      }
      out.write_char('"')
      i += 1
    } else if c.is_ascii_alphabetic() {
      let start = i
      while i < chars.length() &&
            (chars[i].is_ascii_alphabetic() || chars[i] == '-') {
        i += 1
      }
      let word = String::from_array(chars[start:i])
      let mut j = i
      while j < chars.length() && chars[j] is (' ' | '\t') {
        j += 1
      }
      // A key is followed by `:`; `null`, `true` and `false` are values.
      if j < chars.length() && chars[j] == ':' {
        out.write_string("\"\{word}\"")
      } else {
        out.write_string(word)
      }
    } else if c == ',' {
      let mut j = i + 1
      while j < chars.length() && chars[j] is (' ' | '\n' | '\r' | '\t') {
        j += 1
      }
      if j == chars.length() || !(chars[j] is (']' | '}')) {
        out.write_char(',')
      }
      i += 1
    } else {
      out.write_char(c)
      i += 1
    }
  }
  @json.parse(out.to_string())
}

///|
fn rows_of(json : Json) -> Array[Json] raise {
  guard json is Array(rows) else { fail("expected an array") }
  rows
}

///|
async fn write_if_changed(target : String, text : String) -> Unit {
  if !@fs.exists(target) || @fs.read_file(target).text() != text {
    @fs.write_file(target, text)
    println("wrote \{target}")
  } else {
    println("unchanged \{target}")
  }
}

///|
async fn main {
  let args = @env.args()[1:].to_owned()
  match args {
    ["url", source] => {
      let rows = url_rows(@fs.read_file(source).text())
      write_if_changed(
        "conformance/src/url/urltestdata_wbtest.mbt",
        header + string_of_rows("urltestdata", rows),
      )
    }
    ["cookie", parser, examples, bsd_examples] => {
      let text = header +
        string_of_rows(
          "parser_tests",
          rows_of(literal_to_json(@fs.read_file(parser).text())),
        ) +
        string_of_rows(
          "date_examples",
          rows_of(literal_to_json(@fs.read_file(examples).text())),
        ) +
        string_of_rows(
          "date_bsd_examples",
          rows_of(literal_to_json(@fs.read_file(bsd_examples).text())),
        )
      write_if_changed("conformance/src/cookie/http_state_wbtest.mbt", text)
    }
    _ => {
      println(
        "usage: moon run scripts/gen_vectors.mbtx -- url <urltestdata.json> | cookie <parser.ts> <examples.ts> <bsd-examples.ts>",
      )
      @sys.exit(2)
    }
  }
}
