///|
///
/// Generated string enum PermissionGrantScope.
pub(all) enum PermissionGrantScope {
  Turn
  Session
  Custom(String)
}

///|
///
/// Encodes this string enum as JSON.
pub extend PermissionGrantScope with ToJson::{to_json}

///|
pub impl ToJson for PermissionGrantScope with fn to_json(self) {
  let raw = match self {
    Turn => "turn"
    Session => "session"
    Custom(raw) => raw
  }
  raw.to_json()
}

///|
///
/// Decodes this string enum from JSON.
pub extend PermissionGrantScope with @json.FromJson::{from_json}

///|
pub impl @json.FromJson for PermissionGrantScope with fn from_json(value, path) {
  @sdkjson.open_string(
    value,
    path,
    raw => {
      match raw {
        "turn" => Some(Turn)
        "session" => Some(Session)
        _ => None
      }
    },
    raw => Custom(raw),
  )
}

