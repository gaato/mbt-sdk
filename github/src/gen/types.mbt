/// State of this Pull Request. Either `open` or `closed`.
pub(all) enum PullRequestState {
  Open
  Closed
  Unknown(String)
} derive(Eq, @debug.Debug)

///|
pub extend PullRequestState with Eq::{equal, not_equal}

///|
pub extend PullRequestState with @debug.Debug::{to_repr}

///|
///
/// Encodes this string enum as JSON.
pub extend PullRequestState with ToJson::{to_json}

///|
pub impl ToJson for PullRequestState with fn to_json(self) {
  let raw = match self {
    Open => "open"
    Closed => "closed"
    Unknown(raw) => raw
  }
  raw.to_json()
}

///|
///
/// Decodes this string enum from JSON.
pub extend PullRequestState with @json.FromJson::{from_json}

///|
pub impl @json.FromJson for PullRequestState with fn from_json(value, path) {
  @sdkjson.open_string(
    value,
    path,
    raw => {
      match raw {
        "open" => Some(Open)
        "closed" => Some(Closed)
        _ => None
      }
    },
    raw => Unknown(raw),
  )
}

