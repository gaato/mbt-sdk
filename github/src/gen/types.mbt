  let raw = match self {
    Integration => "Integration"
    OrganizationAdmin => "OrganizationAdmin"
    RepositoryRole => "RepositoryRole"
    Team => "Team"
    DeployKey => "DeployKey"
    User => "User"
    Unknown(raw) => raw
  }
  raw.to_json()
}

