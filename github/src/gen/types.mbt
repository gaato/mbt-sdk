///|
///
/// The reaction to use
pub(all) enum ReactionContent {
  Plus1
  Minus1
  Laugh
  Confused
  Heart
  Hooray
  Rocket
  Eyes
  Unknown(String)
} derive(Eq, @debug.Debug)

///|
pub extend ReactionContent with Eq::{equal, not_equal}

///|
pub extend ReactionContent with @debug.Debug::{to_repr}

///|
///
/// Encodes this string enum as JSON.
pub extend ReactionContent with ToJson::{to_json}

///|
pub impl ToJson for ReactionContent with fn to_json(self) {
  let raw = match self {
    Plus1 => "+1"
    Minus1 => "-1"
    Laugh => "laugh"
    Confused => "confused"
    Heart => "heart"
    Hooray => "hooray"
    Rocket => "rocket"
    Eyes => "eyes"
    Unknown(raw) => raw
  }
  raw.to_json()
}

///|
///
/// Decodes this string enum from JSON.
pub extend ReactionContent with @json.FromJson::{from_json}

///|
pub impl @json.FromJson for ReactionContent with fn from_json(value, path) {
  @sdkjson.open_string(
    value,
    path,
    raw => {
      match raw {
        "+1" => Some(Plus1)
        "-1" => Some(Minus1)
        "laugh" => Some(Laugh)
        "confused" => Some(Confused)
        "heart" => Some(Heart)
        "hooray" => Some(Hooray)
        "rocket" => Some(Rocket)
        "eyes" => Some(Eyes)
        _ => None
      }
    },
    raw => Unknown(raw),
  )
}

