  classification : DependabotAlertSecurityAdvisoryClassification?
  cvss : DependabotAlertSecurityAdvisoryCvss
  cvss_severities : @sdkjson.Presence[CvssSeverities]
  epss : @sdkjson.Presence[SecurityAdvisoryEpss]
  cwes : Array[DependabotAlertSecurityAdvisoryCwesItem]
  identifiers : Array[DependabotAlertSecurityAdvisoryIdentifiersItem]
  references : Array[DependabotAlertSecurityAdvisoryReferencesItem]
  published_at : String
  updated_at : String
  withdrawn_at : String?
} derive(Eq, @debug.Debug)

