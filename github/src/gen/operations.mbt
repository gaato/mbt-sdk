  sort? : ActivityListReposStarredByUserSort,
  direction? : ActivityListReposStarredByUserDirection,
  per_page? : Int32,
  page? : Int32,
) -> @model.Request {
  let mut url = "/users/" +
    @model.percent_encode(parameter_value(username)) +
    "/starred"
  match sort {
    Some(value) =>
      url = @model.append_query(url, "sort", parameter_value(value))
    None => ()
  }
  match direction {
    Some(value) =>
      url = @model.append_query(url, "direction", parameter_value(value))
    None => ()
  }
  match per_page {
    Some(value) =>
      url = @model.append_query(url, "per_page", parameter_value(value))
    None => ()
  }
  match page {
    Some(value) =>
      url = @model.append_query(url, "page", parameter_value(value))
    None => ()
  }
  @model.Request::get(url)
}

///|
///
/// Decodes a parsed successful activity/list-repos-starred-by-user response.
pub fn activity_list_repos_starred_by_user_decode_json(
  value : Json,
) -> Array[Repository] raise @json.JsonDecodeError {
  @json.from_json(value)
}

///|
///
/// Decodes a successful activity/list-repos-starred-by-user response.
pub fn activity_list_repos_starred_by_user_decode(
  head : @model.ResponseHead,
  body : Bytes,
) -> Array[Repository] raise @client.ResponseError {
  decode_response(head, body)
}

