///|
pub extend FieldError with Eq::{equal, not_equal}

///|
pub extend FieldError with @debug.Debug::{to_repr}

///|
///
/// Creates a FieldError with omitted optional fields absent.
pub fn FieldError::new(
  field~ : String,
  message~ : String,
  type_~ : String,
  input? : Json,
) -> FieldError {
  { field, message, type_, input: @sdkjson.Presence::from_option(input), }
}

///|
///
/// Encodes this value as JSON.
pub extend FieldError with ToJson::{to_json}

///|
pub impl ToJson for FieldError with fn to_json(self) {
  @sdkjson.ObjBuilder::new()
  .field("field", self.field)
  .field("message", self.message)
  .field("type", self.type_)
  .presence("input", self.input)
  .build()
}

///|
///
/// Decodes this value from JSON.
pub extend FieldError with @json.FromJson::{from_json}

///|
pub impl @json.FromJson for FieldError with fn from_json(value, path) {
  let obj = @sdkjson.expect_object(value, path)
  {
    field: required_field(obj, "field", path),
    message: required_field(obj, "message", path),
    type_: required_field(obj, "type", path),
    input: @sdkjson.presence_field(obj, "input", path),
  }
}

