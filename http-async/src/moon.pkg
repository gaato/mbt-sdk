import {
  "gaato/http",
  "gaato/http/clock",
  "gaato/http/sync",
  "moonbitlang/async/semaphore",
  "moonbitlang/async/cond_var",
  "moonbitlang/async",
  "moonbitlang/async/http" @ahttp,
  "moonbit-community/flate",
  "moonbit-community/flate/gzip",
  "moonbit-community/flate/zlib",
  "gaato/brotli",
}

import {
  "gaato/http-async" @adapter,
  "gaato/http-async/mock" @simclock,
  "gaato/http/cookie",
  "gaato/http/mock",
  "gaato/http/sse",
  "moonbitlang/async/aqueue",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
} for "test"

import {
  "gaato/http-async/mock" @simclock,
  "moonbitlang/async/io",
  "moonbitlang/core/debug",
  "moonbitlang/core/random",
} for "wbtest"

supported_targets = "js + native + wasm"

options(
  targets: {
    "failure.native.mbt": [ "native", "wasm" ],
    "failure.js.mbt": [ "js" ],
    "failure_native_wbtest.mbt": [ "native", "wasm" ],
    "failure_js_wbtest.mbt": [ "js" ],
    "negotiation.native.mbt": [ "native", "wasm" ],
    "negotiation.js.mbt": [ "js" ],
  },
)
