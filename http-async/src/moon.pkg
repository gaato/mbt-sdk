import {
  "gaato/http",
  "gaato/http/clock",
  "gaato/http/sync",
  "moonbitlang/async/semaphore",
  "moonbitlang/async/cond_var",
  "moonbitlang/async",
  "moonbitlang/async/http" @ahttp,
  "moonbit-community/flate",
  "moonbit-community/flate/gzip",
  "moonbit-community/flate/zlib",
  "gaato/brotli",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/percent",
  "moonbitlang/core/env",
}

import {
  "gaato/http-async" @adapter,
  "gaato/http-async/mock" @simclock,
  "gaato/http/cookie",
  "gaato/http/mock",
  "gaato/http/sse",
  "moonbitlang/async/aqueue",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
} for "test"

import {
  "gaato/http-async/mock" @simclock,
  "moonbitlang/async/io",
  "moonbitlang/async/socket",
  "moonbitlang/core/debug",
  "moonbitlang/core/random",
} for "wbtest"

supported_targets = "js + native + wasm"

// The wbtest socket import is used only by native and Wasm files. Moon does
// not yet support conditional imports; on JS it is intentionally unused.

warnings = "-unused_package"

options(
  targets: {
    "failure.native.mbt": [ "native", "wasm" ],
    "failure.js.mbt": [ "js" ],
    "failure_native_wbtest.mbt": [ "native", "wasm" ],
    "failure_js_wbtest.mbt": [ "js" ],
    "negotiation.native.mbt": [ "native", "wasm" ],
    "negotiation.js.mbt": [ "js" ],
    "proxy.native.mbt": [ "native", "wasm" ],
    "proxy.js.mbt": [ "js" ],
    "proxy_js_wbtest.mbt": [ "js" ],
    "proxy_env_wbtest.mbt": [ "native", "wasm" ],
    "request_body.native.mbt": [ "native", "wasm" ],
    "request_body.js.mbt": [ "js" ],
    "upload_js_test.mbt": [ "js" ],
  },
)
