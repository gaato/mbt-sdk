import {
  "gaato/http-async" @adapter,
  "gaato/http",
  "gaato/http/cookie",
  "gaato/http/mock",
  "gaato/http/sse",
  "moonbitlang/async",
  "moonbitlang/async/http" @ahttp,
  "moonbitlang/async/socket",
  "moonbitlang/async/io",
} for "test"

supported_targets = "native + wasm"

options(
  targets: {
    "loopback_test.mbt": [ "native", "wasm" ],
    "pool_test.mbt": [ "native", "wasm" ],
    "cookie_roundtrip_test.mbt": [ "native", "wasm" ],
  },
)
