    "content_coding_test.mbt": [ "native", "wasm" ],
    "cookie_roundtrip_test.mbt": [ "native", "wasm" ],
    "phase_test.mbt": [ "native", "wasm" ],
    "upload_test.mbt": [ "native", "wasm" ],
    "proxy_test.mbt": [ "native", "wasm" ],
  },
)
