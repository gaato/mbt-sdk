import {
  "gaato/http-async" @adapter,
  "gaato/http-async/mock" @simclock,
  "gaato/http",
  "gaato/http/cookie",
  "gaato/http/mock",
  "gaato/http/sse",
  "moonbitlang/async",
  "moonbitlang/async/http" @ahttp,
  "moonbitlang/async/socket",
  "moonbitlang/async/io",
  "gaato/deflate/gzip",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
} for "test"

supported_targets = "native + wasm"

options(
  targets: {
    "loopback_test.mbt": [ "native", "wasm" ],
